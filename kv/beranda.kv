<Beranda>:
    MDFloatLayout:
        md_bg_color: ("#fff9e1")  # warna krem muda

        #MDLabel:
        #    id: welcome_label
        #    text: "Hi User!"
        #    font_name: "League Spartan"
        #    theme_text_color: "Custom"
        #    text_color: ("#232c7c")

        # Sidebar kiri
        MDBoxLayout:
            orientation: "vertical"
            size_hint_x: 0.18
            md_bg_color: ("#fff9e1")  
            padding: dp(16), dp(24)
            spacing: dp(24)

            #logo atas
            #AnchorLayout:
            #    size_hint_y: None
            #    height: dp(120)
            #    anchor_x: "center"
            #    anchor_y: "top"

            Image:
                source: "kv/asset/foto/logoPersonaQuest.png"
                size_hint: None, None
                size: dp(150), dp(150)
                width: dp(150)
                pos_hint:{"center_x": 0.50}

            MDSeparator:
                height: dp(1)

            # Menu
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(12)

                # Baris Beranda
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(32)
                    spacing: dp(8)
                    padding: 0, dp(4)
                    valign: "middle"

                    #Image:
                    #    source: "kv/asset/foto/logo beranda.png"
                    #    size_hint: 0.1, 0.1
                    #    #size: dp(22), dp(22)
                    #    allow_stretch: False
                    #    pos_hint:{"center_x": 0.35, "center_y": 0.38}

                    MDFlatButton:
                        text: "Beranda"
                        theme_text_color: "Custom"
                        text_color: ("#232c7c")
                        md_bg_color: (0, 0, 0, 0)
                        font_name: "OpenSans"
                        halign: "left"
                        valign: "center"
                        size_hint: 1, None
                        height: dp(24)
                        #on_release: root.ke_beranda()  # kalau ada fungsi

                # Baris Profil
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(32)
                    spacing: dp(8)
                    padding: 0, dp(4)
                    valign: "middle"

                    #Image:
                    #    source: "kv/asset/foto/logo profil.png"
                    #    size_hint: 0.1, 0.1
                    #    size: dp(24), dp(24)
                    #    width: dp(25)
                    #   pos_hint:{"center_x":0.35, "center_y": 0.20}

                    MDFlatButton:
                        text: "Profil"
                        # icon: "account-circle-outline"
                        theme_text_color: "Custom"
                        text_color:("#232c7c")                        
                        md_bg_color:("#fff9e1")
                        halign: "left"
                        font_name: "OpenSans"
                        valign: "center"
                        size_hint: 1, None
                        #size_hint_y: None
                        height: dp(28)
                        #pos_hint:{"center_x": 0.33}

                # Baris Pengaturan
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(32)
                    spacing: dp(8)
                    padding: 0, dp(4)
                    valign: "middle"

                    #Image:
                    #    source: "kv/asset/foto/logo pengaturan.png"
                    #    size_hint: 0.1, 0.1
                    #    size: dp(24), dp(24)
                    #    width: dp(25)
                    #   pos_hint:{"center_x":0.35, "center_y": 0.20}

                    MDFlatButton:
                        text: "Pengaturan"
                        icon: "cog-outline"
                        theme_text_color: "Custom"
                        text_color: ("#232c7c")
                        md_bg_color: ("#fff9e1")
                        halign: "left"
                        font_name: "OpenSans"
                        pos_hint:{"center_x": 0.40}
                        size_hint: 1, None

                # Baris Tentang Kami
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(32)
                    spacing: dp(8)
                    padding: 0, dp(4)
                    valign: "middle"

                    #Image:
                    #    source:"kv/asset/foto/logo tentang kami.png"
                    #    size_hint: 0.1, 0.1
                    #    size: dp(24), dp(24)
                    #    width: dp(25)
                    #   pos_hint:{"center_x":0.35, "center_y": 0.20}

                    MDFlatButton:
                        text: "Tentang Kami"
                        icon: "account-group-outline"
                        theme_text_color: "Custom"
                        text_color: ("#232c7c")
                        md_bg_color: ("#fff9e1")
                        halign: "left"
                        font_name: "OpenSans"
                        pos_hint:{"center_x": 0.43}
                        size_hint: 1, None

                Widget:
                # Baris Keluar
                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(32)
                    spacing: dp(8)
                    padding: 0, dp(4)
                    valign: "middle"

                    #Image:
                    #    source:"kv/asset/foto/logo tentang kami.png"
                    #    size_hint: 0.1, 0.1
                    #    size: dp(24), dp(24)
                    #    width: dp(25)
                    #   pos_hint:{"center_x":0.35, "center_y": 0.20}

                    MDFlatButton:
                        text: "Keluar"
                        icon: "logout"
                        theme_text_color: "Custom"
                        text_color: ("#ff0303ff")
                        md_bg_color:("#fff9e1")
                        halign: "left"
                        font_name: "OpenSans"
                        pos_hint:{"center_x": 0.35}
                        size_hint: 1, None
                        on_release: app.logout()

        # Area konten kanan
        MDFloatLayout:
            size_hint_x: 0.82
            pos_hint: {"x": 0.18}
            md_bg_color: ("#232c7c")

            MDCard:  # header
                size_hint: 0.95, 0.12
                pos_hint: {"x": 0.04, "top": 0.98}
                md_bg_color: ("#232c7c")
                radius: [dp(24), dp(24), dp(24), dp(24)]
                elevation: 0
                padding: dp(24)
                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: dp(12)

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(8)
                        MDLabel:
                            text: "Beranda"
                            font_size: "35sp"
                            theme_text_color: "Custom"
                            text_color: ("#ffffffff")
                            font_name: "LeagueSpartan"
                        MDLabel:
                            id: tanggal_label
                            text: "Kamis, 27 November 2025"
                            theme_text_color: "Custom"
                            text_color: ("#ffffffff")
                            font_name: "OpenSans"

                    Widget:

                    MDIconButton:
                        icon: "flag"
                        theme_text_color: "Custom"
                        text_color: ("#ffffffff")
                    MDIconButton:
                        icon: "account-circle"
                        theme_text_color: "Custom"
                        text_color: ("#ffffffff")

            # Card besar sapaan
            MDCard:
                size_hint: 0.92, 0.43
                pos_hint: {"center_x": 0.50, "center_y": 0.63}
                md_bg_color: ("#fff9e1")
                radius: [dp(24), dp(24), dp(24), dp(24)]
                elevation: 0
                padding: dp(24)

                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: dp(16)
                    
                    MDBoxLayout:
                        orientation: "vertical"
                        size_hint_x: 0.5
                        spacing: dp(8)
                        padding: 0, 0, 0, 0
                        MDLabel:
                            id: welcome_label
                            text: ''
                            font_size: "50sp"
                            font_name: "LeagueSpartan"
                            theme_text_color: "Custom"
                            text_color: ("#232c7c")
                            halign: "left"
                            text_size: self.width, None
                        MDLabel:
                            id : quote_label
                            text: "Isi harimu dengan hal-hal yang membuatmu hidup"
                            font_name: "OpenSans"
                            font_size: "15sp"
                            theme_text_color:"Custom"
                            text_color: ("#232c7c")
                            halign: "left"
                            text_size: self.width, None

                    # Gambar ilustrasi kanan (orang laptop + melukis placeholder)
                    FloatLayout:
                        size_hint_x: 0.5
                        #padding: dp(10), dp(20), dp(0), dp(40)
                        #valign: "bottom"
                        #anchor_x: "right"
                        #anchor_y: "center"
                        Image:
                            source: "kv/asset/foto/logo orang beranda.png"
                            allow_stretch: True
                            keep_ratio: True
                            size_hint: None, None
                            size: dp(740), dp(540)
                            pos_hint: {"center_y": 0.40, "center_x": 0.49}

            # Card grid 4 tombol tes
            MDCard:
                size_hint: 0.92, 0.33
                pos_hint: {"x": 0.04, "y": 0.05}
                md_bg_color: ("#fff9e1")
                radius: [dp(24), dp(24), dp(24), dp(24)]
                elevation: 0
                padding: dp(24)

                MDBoxLayout:
                    spacing: dp(24)

                    # Tes Kepribadian
                    MDCard:
                        orientation: "vertical"
                        size_hint_x: 0.22
                        md_bg_color: ("#ffffffff")
                        radius: [dp(24), dp(24), dp(24), dp(24)]
                        elevation: 1
                        padding: dp(4)
                        
                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(8)

                            MDIconButton:
                                icon: "kv/asset/foto/logo tes mbti.png"
                                theme_icon_color: "Custom"
                                icon_size: "180sp"
                                size_hint: 1, 1
                                allow_stretch: True
                                size: dp(80), dp(80)
                                #pos_hint: {"center_x": 0.5}
                                on_release: app.root.current = "quizmbti"


                    # Kenali Minat & Bakat
                    MDCard:
                        orientation: "vertical"
                        size_hint_x: 0.22
                        md_bg_color: ("#ffffffff")
                        radius: [dp(24), dp(24), dp(24), dp(24)]
                        elevation: 1
                        padding: dp(4)

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(8)

                            MDIconButton:
                                icon: "kv/asset/foto/logo tes minat bakat.png"
                                theme_icon_color: "Custom"
                                icon_size: "180sp"
                                size_hint: 1, 1
                                allow_stretch: True
                                size: dp(80), dp(80)
                                #pos_hint: {"center_x": 0.5}
                                #on_release: app.ke_minat_bakat()

                    # Tentukan Karir dan Jurusan
                    MDCard:
                        orientation: "vertical"
                        size_hint_x: 0.22
                        md_bg_color: ("#ffffffff")
                        radius: [dp(24), dp(24), dp(24), dp(24)]
                        elevation: 1
                        padding: dp(4)

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(8)

                            MDIconButton:
                                icon: "kv/asset/foto/logo karir jurusan.png"
                                theme_icon_color: "Custom"
                                icon_size: "180sp"
                                size_hint: 1, 1
                                allow_stretch: True
                                size: dp(80), dp(80)
                                #pos_hint: {"center_x": 0.5}
                                #on_release: app.ke_karir_jurusan()

                     

                    # Tes Gaya Belajar
                    MDCard:
                        orientation: "vertical"
                        size_hint_x: 0.22
                        md_bg_color: ("#ffffffff")
                        radius: [dp(24), dp(24), dp(24), dp(24)]
                        elevation: 1
                        padding: dp(4)
                        
                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(8)

                            MDIconButton:
                                icon: "kv/asset/foto/logo gaya belajar.png"
                                theme_icon_color: "Custom"
                                icon_size: "180sp"
                                size_hint: 1, 1
                                allow_stretch: True
                                size: dp(80), dp(80)
                                #on_release: app.ke_gaya_belajar()

