<CircleButton@MDIconButton>:
    icon: "circle"
    user_font_size: "22sp"
    md_bg_color: 0, 0, 0, 0
    theme_text_color: "Custom"
    text_color: 1, 1, 1, 1
    selected: False

    on_release:
        self.selected = not self.selected
        # warna titik saat terpilih (biru), kalau tidak tetap putih
        self.text_color = (0.1, 0.5, 1, 1) if self.selected else (1, 1, 1, 1)

<QuestionBox@BoxLayout>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    spacing: "4dp"
    no: 0
    question_text: ""
    selected_value: 0    # nilai 1-5 yang dipilih

    MDLabel:
        text: (str(root.no) + ". " + root.question_text) if root.no else ""
        theme_text_color: "Primary"
        bold: True
        text_size: self.width, None
        size_hint_y: None
        height: self.texture_size[1] + dp(8)

    BoxLayout:
        size_hint_y: None
        height: "50dp"
        spacing: 0

        #1
        BoxLayout:
            canvas.before:
                Color:
                    rgba: 0.87, 0.10, 0.10, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            padding: "8dp"
            CircleButton:
                text_color: (0.1, 0.5, 1, 1) if root.selected_value == 1 else (1, 1, 1, 1)
                on_release:
                    app.get_running_app().wm.get_screen("quizmbti").set_answer(root.no, 1)
                    root.selected_value = 1
        #2
        BoxLayout:
            canvas.before:
                Color:
                    rgba: 0.95, 0.30, 0.30, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            padding: "8dp"
            CircleButton:
                text_color: (0.1, 0.5, 1, 1) if root.selected_value == 2 else (1, 1, 1, 1)
                on_release:
                    app.get_running_app().wm.get_screen("quizmbti").set_answer(root.no, 2)
                    root.selected_value = 2
        #3
        BoxLayout:
            canvas.before:
                Color:
                    rgba: 0.76, 0.76, 0.76, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            padding: "8dp"
            CircleButton:
                text_color: (0.1, 0.5, 1, 1) if root.selected_value == 3 else (1, 1, 1, 1)
                on_release:
                    app.get_running_app().wm.get_screen("quizmbti").set_answer(root.no, 3)
                    root.selected_value = 3
        #4
        BoxLayout:
            canvas.before:
                Color:
                    rgba: 0.64, 0.90, 0.60, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            padding: "8dp"
            CircleButton:
                text_color: (0.1, 0.5, 1, 1) if root.selected_value == 4 else (1, 1, 1, 1)
                on_release: 
                    app.get_running_app().wm.get_screen("quizmbti").set_answer(root.no, 4)
                    root.selected_value = 4
        #5
        BoxLayout:
            canvas.before:
                Color:
                    rgba: 0.26, 0.80, 0.26, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
            padding: "8dp"
            CircleButton:
                text_color: (0.1, 0.5, 1, 1) if root.selected_value == 5 else (1, 1, 1, 1)
                on_release:
                    app.get_running_app().wm.get_screen("quizmbti").set_answer(root.no, 5)
                    root.selected_value = 5


<QuizScreen>:
    name: "quizmbti"
    #orientation: "vertical"
    #padding: "16dp"
    #spacing: "8dp"
    md_bg_color: 1, 1, 0.9, 1
                     
    #MDLabel:
    #    text: "Tes MBTI"
    #    halign: "center"
    #    theme_text_color: "Primary"
    #    font_style: "H5"
    #    size_hint_y: None
    #    height: self.texture_size[1] + dp(8)

    ScrollView:
        do_scroll_x: False
        do_scroll_y: True

        BoxLayout:
            #id: questions_container
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            padding: dp(32), dp(32)
            spacing: dp(20)

            # Judul di tengah atas, ikut scroll
            MDLabel:
                text: "Tes MBTI"
                halign: "center"
                theme_text_color: "Primary"
                font_name: "Monradok"
                font_size: "35sp"
                size_hint_y: None
                height: self.texture_size[1] + dp(8)
            
            MDRaisedButton:
                text:"<"
                font_size : "16sp"              
                font_name: "OpenSans"   
                theme_text_color: "Primary"                
                size_hint_x: None                    
                pos_hint: {"x": 0.05, "top": 0.95}                                    
                on_press: app.root.current = 'beranda'

            # Wadah utama yang lebarnya dibatasi dan di-center
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                size_hint_x: None
                width: min(root.width * 0.7, dp(900))  # tidak terlalu melebar
                pos_hint: {"center_x": 0.5}
                spacing: dp(16)

                BoxLayout:
                    id: questions_container
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "12dp"

                Widget:
                    size_hint_y: None
                    height: dp(16)

                #BoxLayout:
                #    size_hint_x: None
                #    width: min(root.width * 0.7, dp(900))
                #    pos_hint: {"center_x": 0.5}
                #    spacing: dp(16)
                BoxLayout:
                    size_hint_y: None
                    height: dp(56)
                    spacing: dp(16)

                    MDFillRoundFlatButton:
                        text: "Previous"
                        size_hint_x: None
                        width: dp(120)
                        disabled: root.current_page == 1
                        on_release: root.go_previous_page()

                    Widget:

                    MDFillRoundFlatButton:
                        text: "Next"
                        size_hint_x: None
                        width: dp(120)
                        # max_page = (len(questions) - 1) // page_size
                        opacity: 1 if root.current_page < (len(root.questions) - 1) // root.page_size else 0
                        disabled: root.current_page >= (len(root.questions) - 1) // root.page_size
                        on_release: root.go_next_page()


                    MDRaisedButton:
                        text: "Hitung Skor"
                        size_hint_x: None
                        width: dp(140)
                        opacity: 1 if root.current_page == (len(root.questions) - 1) // root.page_size else 0
                        disabled: root.current_page != (len(root.questions) - 1) // root.page_size
                        on_release: root.calculate_score()